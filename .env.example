# ---------------------------------------------------------------------------
# Digital Menu - environment variables
# Copy this file to `.env` (local runs) or set the variables in your hosting
# dashboard. NEVER commit a real `.env` file and never put real secrets in git.
# ---------------------------------------------------------------------------

# Environment: "production" enables strict checks (HTTPS-only cookies, HSTS,
# no debug output in errors, mandatory SESSION_SECRET).
NODE_ENV=production

# Port the HTTP server listens on.
PORT=3000

# Directory for the SQLite database and uploaded images.
# In Docker this is a mounted volume so data survives container restarts.
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Secrets - generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# Signs the admin session cookie. REQUIRED in production.
# Changing it logs every admin out.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Admin bootstrap account (optional but recommended)
# ---------------------------------------------------------------------------
# When ADMIN_EMAIL and ADMIN_PASSWORD are both set, the server creates that
# admin account on startup, and re-applies the password on every restart
# (the environment is the source of truth for this bootstrap account).
# Leave them unset if you prefer to manage the password inside the panel
# (Admin -> Change password) or with: npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# 1 = the app runs behind a reverse proxy (nginx, Caddy, CDN, PaaS router).
#     Trust one proxy hop for the client IP (needed by rate limiting).
# 0 = the app is exposed directly to the internet.
TRUST_PROXY=1

# 1 = redirect http -> https and send HSTS. Requires HTTPS to be terminated
#     by the reverse proxy. Keep 0 for local development/preview.
FORCE_HTTPS=1

# Public base URL of the menu, used to build the QR code link.
# Example: https://menu.example.com
PUBLIC_BASE_URL=

# Comma-separated host allowlist for the Host header (defence in depth).
# Wildcards are allowed, e.g. "*.example.com,localhost". Empty = allow any.
ALLOWED_HOSTS=

# Set to 1 to load the demo menu when the database is empty (first boot).
SEED_DEMO=0
